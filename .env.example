# ============================================================================
# Chaves de API gratuitas para analise dos cortes (multi-provedor automatico)
# ============================================================================
# Voce pode misturar chaves gratuitas de diferentes provedores!
# O sistema identifica o provedor automaticamente pelo prefixo da chave:
#
#   sk-or-v1-... -> OpenRouter (1 chave = dezenas de modelos :free)
#   gsk_...      -> Groq       (Llama 3.3 70B / GPT-OSS 120B super rapidos)
#   csk-...      -> Cerebras   (1M tokens/dia gratis)
#   AIza...      -> Google AI Studio (gemini-3.8-flash / gemini-3.6-flash / gemini-3.5-flash)
#   mistral:...  -> Mistral La Plateforme (prefixe com mistral: ou use MISTRAL_API_KEY)
#
# Uma unica chave:
API_KEY=

# Ou varias chaves numeradas (rotacao automatica entre provedores e contas):
# API_KEY_1=sk-or-v1-sua_chave_openrouter
# API_KEY_2=gsk_sua_chave_groq
# API_KEY_3=AIzaSy_sua_chave_google

# Ou separadas por virgula:
# API_KEYS=sk-or-v1-...,gsk_...,AIzaSy...

# Opcional: chaves por provedor especifico
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=

# Opcional: forcar lista de modelos (separados por virgula) ou provedor padrao
# AI_PROVIDER=openrouter
# AI_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-super-vl:free,llama-3.3-70b-versatile
